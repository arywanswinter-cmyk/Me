<?xml version="1.0" encoding="UTF-8"?>
<!--
  ElevenLabs pronunciation dictionary for the Iran episode.
  Uses <alias> (plain-English respellings) because alias rules work on every
  ElevenLabs model, including Multilingual v2. Phoneme (IPA/CMU) rules only
  work on the Flash v2 / Turbo v2 / English v1 models.
  Matching is case-sensitive and the first matching entry wins, so longer
  forms (Aminian, Jina) sit above the shorter ones they contain (Amini, Jin).
  Respellings are approximations: audition each name and adjust by ear.
-->
<lexicon version="1.0"
      xmlns="http://www.w3.org/2005/01/pronunciation-lexicon"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.w3.org/2005/01/pronunciation-lexicon
        http://www.w3.org/TR/2007/CR-pronunciation-lexicon-20071212/pls.xsd"
      alphabet="ipa" xml:lang="en-GB">

  <!-- Kurdish: the J in these is a "zh" sound, as in "measure" -->
  <lexeme><grapheme>Jina</grapheme><alias>Zheena</alias></lexeme>
  <lexeme><grapheme>Jiyan</grapheme><alias>Zhee-yahn</alias></lexeme>
  <lexeme><grapheme>Jin</grapheme><alias>Zhin</alias></lexeme>
  <lexeme><grapheme>Azadî</grapheme><alias>Ah-zah-dee</alias></lexeme>

  <!-- Persian: Jaleh is also a "zh" sound -->
  <lexeme><grapheme>Jaleh</grapheme><alias>Zhah-leh</alias></lexeme>

  <!-- People -->
  <lexeme><grapheme>Rubina's</grapheme><alias>Roo-bee-nah's</alias></lexeme>
  <lexeme><grapheme>Rubina</grapheme><alias>Roo-bee-nah</alias></lexeme>
  <lexeme><grapheme>Aminian's</grapheme><alias>Ah-mee-nee-ahn's</alias></lexeme>
  <lexeme><grapheme>Aminian</grapheme><alias>Ah-mee-nee-ahn</alias></lexeme>
  <lexeme><grapheme>Amini's</grapheme><alias>Ah-mee-nee's</alias></lexeme>
  <lexeme><grapheme>Amini</grapheme><alias>Ah-mee-nee</alias></lexeme>
  <lexeme><grapheme>Mahsa</grapheme><alias>Mah-sah</alias></lexeme>
  <lexeme><grapheme>Khamenei</grapheme><alias>Khah-meh-neh-ee</alias></lexeme>
  <lexeme><grapheme>Mojtaba</grapheme><alias>Moj-tah-bah</alias></lexeme>
  <lexeme><grapheme>Mohsen</grapheme><alias>Moh-sen</alias></lexeme>
  <lexeme><grapheme>Shekari</grapheme><alias>Sheh-kah-ree</alias></lexeme>
  <lexeme><grapheme>Majidreza</grapheme><alias>Mah-jeed-reh-zah</alias></lexeme>
  <lexeme><grapheme>Rahnavard</grapheme><alias>Rah-nah-vard</alias></lexeme>
  <lexeme><grapheme>Ahmadinejad</grapheme><alias>Ah-mah-dee-neh-zhahd</alias></lexeme>
  <lexeme><grapheme>Mir-Hossein</grapheme><alias>Meer Ho-sayn</alias></lexeme>
  <lexeme><grapheme>Mousavi</grapheme><alias>Moo-sah-vee</alias></lexeme>
  <lexeme><grapheme>Neda's</grapheme><alias>Neh-dah's</alias></lexeme>
  <lexeme><grapheme>Neda</grapheme><alias>Neh-dah</alias></lexeme>
  <lexeme><grapheme>Agha-Soltan</grapheme><alias>Ah-ghah Sol-tahn</alias></lexeme>
  <lexeme><grapheme>Batebi</grapheme><alias>Bah-teh-bee</alias></lexeme>
  <lexeme><grapheme>Raisi</grapheme><alias>Rah-ee-see</alias></lexeme>
  <lexeme><grapheme>Sadegh</grapheme><alias>Sah-degh</alias></lexeme>
  <lexeme><grapheme>Khalkhali's</grapheme><alias>Khal-khah-lee's</alias></lexeme>
  <lexeme><grapheme>Khalkhali</grapheme><alias>Khal-khah-lee</alias></lexeme>
  <lexeme><grapheme>Abolhassan</grapheme><alias>Ah-bol-hah-sahn</alias></lexeme>
  <lexeme><grapheme>Bani-Sadr</grapheme><alias>Bah-nee Sadr</alias></lexeme>
  <lexeme><grapheme>Abdorrahman</grapheme><alias>Ab-dor-rah-mahn</alias></lexeme>
  <lexeme><grapheme>Boroumand</grapheme><alias>Bo-roo-mahnd</alias></lexeme>

  <!-- Places and institutions -->
  <lexeme><grapheme>Shariati</grapheme><alias>Shah-ree-ah-tee</alias></lexeme>
  <lexeme><grapheme>Kermanshah</grapheme><alias>Ker-mahn-shah</alias></lexeme>
  <lexeme><grapheme>Kamyaran</grapheme><alias>Kahm-yah-rahn</alias></lexeme>
  <lexeme><grapheme>Kahrizak</grapheme><alias>Kah-ree-zahk</alias></lexeme>
  <lexeme><grapheme>Saqqez</grapheme><alias>Sah-kez</alias></lexeme>
  <lexeme><grapheme>Mashhad</grapheme><alias>Mash-had</alias></lexeme>
  <lexeme><grapheme>Basij</grapheme><alias>Bah-seej</alias></lexeme>
  <lexeme><grapheme>Ansar-e</grapheme><alias>Ahn-sahr-eh</alias></lexeme>
  <lexeme><grapheme>Ayandegan</grapheme><alias>Ah-yahn-deh-gahn</alias></lexeme>
  <lexeme><grapheme>Paveh</grapheme><alias>Pah-veh</alias></lexeme>
  <lexeme><grapheme>Marivan</grapheme><alias>Mah-ree-vahn</alias></lexeme>
  <lexeme><grapheme>Sanandaj</grapheme><alias>Sah-nahn-dahj</alias></lexeme>
  <lexeme><grapheme>Mahabad</grapheme><alias>Mah-hah-bahd</alias></lexeme>

</lexicon>
